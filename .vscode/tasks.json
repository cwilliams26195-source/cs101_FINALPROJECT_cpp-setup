{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Registration App",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g",
                "main.cpp",
                "Student.cpp",
                "Registration.cpp",
                "-o",
                "registration_app.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}